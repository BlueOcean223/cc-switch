{
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    }
  },
  "model": {
    "name": "gemini-2.5-pro",
    "compressionThreshold": 0.5
  },
  "ui": {
    "theme": "GitHub"
  },
  "mcpServers": {
    "external-only": {
      "command": "external"
    },
    "http-server": {
      "type": "http",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer mcp-header"
      }
    },
    "sse-server": {
      "type": "sse",
      "url": "https://mcp.example.com/sse"
    },
    "stdio-server": {
      "command": "example-mcp-server",
      "args": [
        "--stdio"
      ],
      "env": {
        "EXAMPLE_TOKEN": "mcp-token"
      }
    }
  }
}
